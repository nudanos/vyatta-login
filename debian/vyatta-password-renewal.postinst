#! /bin/sh -e
#
# Vyatta PAM config update

pkg=vyatta-password-renewal
pam_unix=/usr/share/pam-configs/unix
pam_unix_bak=/opt/vyatta/share/pam-configs/unix.debian

if [ "$1" = configure ]; then
    if grep -Eq '^[[:space:]]*auth[[:space:]].*pam_tally2?\.so([[:space:]]|$)' /etc/pam.d/common-auth; then
        perl -I/opt/vyatta/share/perl5 -MVyatta::Login::Faillock=migrate_legacy -e 'migrate_legacy()'
    fi
    profile=/usr/share/pam-configs/vyatta-password
    source=/opt/vyatta/share/pam-configs/vyatta-password
    if [ -L "$profile" ] || { [ -e "$profile" ] && ! cmp -s "$profile" "$source"; }; then
        echo "Refusing to overwrite administrator profile $profile" >&2
        exit 1
    fi
    owner=$(dpkg-divert --listpackage "$pam_unix")
    if { [ -n "$owner" ] && [ "$owner" != "$pkg" ]; } ||
       { [ -z "$owner" ] && { [ -e "$pam_unix_bak" ] || [ -L "$pam_unix_bak" ]; }; }; then
        echo "Refusing conflicting diversion of $pam_unix" >&2
        exit 1
    fi
    if [ "$owner" = "$pkg" ] && { [ -L "$pam_unix" ] || { [ -e "$pam_unix" ] && ! cmp -s "$pam_unix" /opt/vyatta/share/pam-configs/vyatta-unix; }; }; then
        echo "Refusing to overwrite administrator profile $pam_unix" >&2
        exit 1
    fi
    if [ -z "$owner" ]; then
        dpkg-divert --package ${pkg} --add --rename \
        --divert ${pam_unix_bak} ${pam_unix}
    fi
    cp -f /opt/vyatta/share/pam-configs/vyatta-unix /usr/share/pam-configs/unix
    cp -f /opt/vyatta/share/pam-configs/vyatta-password /usr/share/pam-configs/
    pam-auth-update --package
    if ! grep -Eq '^[[:space:]]*password[[:space:]].*pam_vyatta_passwd\.so([[:space:]]|$)' /etc/pam.d/common-password; then
        echo "Renewal profile is not active in common-password; review local PAM changes" >&2
        exit 1
    fi
fi

#DEBHELPER#

exit 0
