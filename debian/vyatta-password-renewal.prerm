#! /bin/sh -e
#
# Vyatta PAM config cleanup

pkg=vyatta-password-renewal
pam_unix=/usr/share/pam-configs/unix
pam_unix_bak=/opt/vyatta/share/pam-configs/unix.debian

if [ "$1" = remove ]; then
    for service in /etc/pam.d/* /etc/pam.conf; do
        case "$service" in /etc/pam.d/common-password|*.pam-old|*.pam-new|*.dpkg-old|*.dpkg-dist) continue ;; esac
        [ -f "$service" ] || continue
        if grep -Eq '^[[:space:]]*([^[:space:]]+[[:space:]]+)?password[[:space:]].*pam_vyatta_passwd\.so([[:space:]]|$)' "$service"; then
            echo "Refusing removal while $service loads pam_vyatta_passwd.so" >&2
            exit 1
        fi
    done
    profile=/usr/share/pam-configs/vyatta-password
    source=/opt/vyatta/share/pam-configs/vyatta-password
    owner=$(dpkg-divert --listpackage "$pam_unix")
    if [ -L "$profile" ] || { [ -e "$profile" ] && ! cmp -s "$profile" "$source"; }; then
        echo "Refusing to remove administrator profile $profile" >&2
        exit 1
    fi
    if [ "$owner" = "$pkg" ]; then
        if [ -L "$pam_unix" ] || { [ -e "$pam_unix" ] && ! cmp -s "$pam_unix" /opt/vyatta/share/pam-configs/vyatta-unix; }; then
            echo "Refusing to remove administrator profile $pam_unix" >&2
            exit 1
        fi
        rm -f "$pam_unix"
        dpkg-divert --package "$pkg" --remove --rename --divert "$pam_unix_bak" "$pam_unix"
    elif [ -n "$owner" ]; then
        echo "Refusing to remove another package's diversion of $pam_unix" >&2
        exit 1
    fi
    if ! pam-auth-update --remove vyatta-password ||
       grep -Eq '^[[:space:]]*password[[:space:]].*pam_vyatta_passwd\.so([[:space:]]|$)' /etc/pam.d/common-password ||
       ! grep -Eq '^[[:space:]]*password[[:space:]].*pam_unix\.so([[:space:]]|$)' /etc/pam.d/common-password; then
        if [ "$owner" = "$pkg" ]; then
            dpkg-divert --package "$pkg" --add --rename --divert "$pam_unix_bak" "$pam_unix"
            cp /opt/vyatta/share/pam-configs/vyatta-unix "$pam_unix"
            pam-auth-update --enable vyatta-password || true
        fi
        echo "Refusing removal while the renewal PAM stack remains active or lacks pam_unix" >&2
        exit 1
    fi
    rm -f "$profile"
fi

#DEBHELPER#

exit 0
