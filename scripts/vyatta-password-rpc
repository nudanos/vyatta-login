import os
import sys
import json
from hmac import compare_digest

from crypt_r import crypt
from vyatta import configd

class ChangePassword:
    def __init__(self, cfg_client, pwuser, password):
        self.sessid = str(os.getpid())
        self.client = cfg_client
        self.user = pwuser
        self.path = ["system", "login", "user", pwuser, "authentication",
                     "plaintext-password", password]

    def setup_session(self):
        self.client.session_setup(self.sessid)
        try:
            self.client.session_exists()
        except Exception as exc:
            print(exc)
            sys.exit(1)

    def teardown_session(self):
        self.client.session_teardown()

    def set_password(self, path):
        try:
            self.client.set(path)
        except Exception as exc:
            print(exc)
            sys.exit(1)

    def commit_password(self):
        try:
            msg = "vyatta-system-login-v1:change-password request for user {}".format(self.user)
            self.client.commit(msg)
        except Exception as exc:
            print(exc)
            sys.exit(1)

    def change_password(self):
        self.setup_session()
        try:
            self.set_password(self.path)
            self.commit_password()
        finally:
            self.teardown_session()

def is_current_password(client, pwuser, cur_pw):
    path = "system login user {} authentication encrypted-password".format(pwuser)
    try:
        cur_epw = client.tree_get_dict(path, configd.Client.RUNNING)['encrypted-password']
    except Exception:
        cur_epw = None
    if (isinstance(cur_pw, str) and isinstance(cur_epw, str) and
            cur_epw and not cur_epw.startswith(('!', '*'))):
        try:
            # Let libxcrypt verify the complete stored setting. This supports
            # the configured legacy hashes and modern native hashes such as yescrypt.
            epw = crypt(cur_pw, cur_epw)
            if epw and not epw.startswith('*') and compare_digest(epw, cur_epw):
                return True
        except (TypeError, ValueError, OSError):
            pass
    print("Authentication failure")
    return False

if __name__ == "__main__":
    try:
        user = json.loads(os.environ['VCI_RPC_METADATA'])['User']
        if not isinstance(user, str) or not user:
            raise ValueError
    except (KeyError, TypeError, ValueError):
        print("Invalid RPC user metadata", file=sys.stderr)
        sys.exit(1)

    try:
        rpc_input = json.load(sys.stdin)
        if not isinstance(rpc_input, dict):
            raise ValueError
    except ValueError:
        print("Invalid RPC input", file=sys.stderr)
        sys.exit(1)
    current_pw = rpc_input.get("current-password")

    try:
        client = configd.Client()
    except Exception as exc:
        print(exc)
        sys.exit(1)

    if sys.argv[1] == "verify-password":
        if not is_current_password(client, user, current_pw):
            sys.exit(1)
    elif sys.argv[1] == "change-password":
        if not is_current_password(client, user, current_pw):
            sys.exit(1)
        new_pw = rpc_input.get("new-password")
        try:
            valid = (isinstance(new_pw, str) and bool(new_pw) and
                     not any(c in new_pw for c in "\0\r\n") and
                     len(new_pw.encode("utf-8")) <= 511)
        except UnicodeEncodeError:
            valid = False
        if not valid:
            print("Invalid new password", file=sys.stderr)
            sys.exit(1)
        pw = ChangePassword(client, user, new_pw)
        pw.change_password()
    else:
        print("Invalid command")
        sys.exit(1)
    sys.exit(0)
