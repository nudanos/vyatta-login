import os
import sys
import json
from uuid import uuid4
from hmac import compare_digest

from crypt_r import crypt
from vyatta import configd
from vyatta_password_persistence import SavedPasswordError, verify_saved_password


class PasswordChangeError(Exception):
    """A safe, credential-free error suitable for the RPC response."""


class ChangePassword:
    def __init__(self, cfg_client, pwuser, password, current_password=None):
        self.sessid = "password_" + uuid4().hex
        self.client = cfg_client
        self.user = pwuser
        self.current_password = current_password
        self.path = ["system", "login", "user", pwuser, "authentication",
                     "plaintext-password", password]

    def teardown_session(self):
        self.client.session_teardown()

    def set_password(self, path):
        try:
            self.client.set(path)
        except Exception as exc:
            # Backend syntax diagnostics may contain the submitted plaintext.
            raise PasswordChangeError("Could not prepare the password change") from exc

    def commit_password(self):
        try:
            msg = "vyatta-system-login-v1:change-password request for user {}".format(self.user)
            result = self.client.commit(msg)
        except Exception as exc:
            raise PasswordChangeError(
                "Password commit failed; running state may have changed and saved state is unverified; "
                "contact an administrator before rebooting"
            ) from exc
        if not isinstance(result, str) or "non-fatal failures detected" in result:
            # Configd can apply RUNNING, skip Save and return only this warning.
            # Do not hide a failed end hook by issuing an extra whole-tree Save.
            raise PasswordChangeError(
                "Password changed in running configuration but was not verified as saved; "
                "contact an administrator before rebooting"
            )

    def change_password(self):
        # Commit already saves startup in configd. Holding its writer lock here
        # would deadlock that automatic save; verification is read-only.
        if not is_current_password(self.client, self.user, self.current_password,
                                   report_failure=False):
            raise PasswordChangeError("Authentication failure")
        setup_attempted = False
        completed = False
        try:
            try:
                # Setup can create the server session before its response is
                # lost. The unique ID makes cleanup safe in either case.
                setup_attempted = True
                self.client.session_setup(self.sessid)
                self.client.session_exists()
            except Exception as exc:
                raise PasswordChangeError("Could not establish a password change session") from exc
            self.set_password(self.path)
            path = "system login user {} authentication encrypted-password".format(self.user)
            try:
                # Plaintext substitution completes synchronously during set.
                candidate = self.client.tree_get_dict(path, configd.Client.CANDIDATE)["encrypted-password"]
                if (not isinstance(candidate, str) or not candidate or
                        candidate.startswith(("!", "*")) or len(candidate) > 4096 or
                        not compare_digest(crypt(self.path[-1], candidate), candidate)):
                    raise ValueError("Unusable candidate password")
            except Exception as exc:
                raise PasswordChangeError("Could not verify the candidate encrypted password") from exc
            self.commit_password()
            try:
                running = self.client.tree_get_dict(path, configd.Client.RUNNING)["encrypted-password"]
                if not isinstance(running, str) or not compare_digest(running, candidate):
                    raise PasswordChangeError("Running password changed before verification")
                verify_saved_password(self.user, candidate)
            except Exception as exc:
                # A blind rollback could erase an intervening admin commit.
                raise PasswordChangeError(
                    "Password changed in running configuration but was not verified as saved; "
                    "contact an administrator before rebooting"
                ) from exc
            completed = True
        finally:
            if setup_attempted:
                try:
                    self.teardown_session()
                except Exception as exc:
                    if completed:
                        raise PasswordChangeError(
                            "Password was saved, but configuration session cleanup failed"
                        ) from exc
                    print("Could not discard the password change session", file=sys.stderr)

def is_current_password(client, pwuser, cur_pw, report_failure=True):
    path = "system login user {} authentication encrypted-password".format(pwuser)
    try:
        cur_epw = client.tree_get_dict(path, configd.Client.RUNNING)['encrypted-password']
    except Exception:
        cur_epw = None
    if (isinstance(cur_pw, str) and isinstance(cur_epw, str) and
            cur_epw and not cur_epw.startswith(('!', '*'))):
        try:
            # Let libxcrypt verify the complete stored setting. This supports
            # the configured legacy hashes and modern native hashes such as yescrypt.
            epw = crypt(cur_pw, cur_epw)
            if epw and not epw.startswith('*') and compare_digest(epw, cur_epw):
                return True
        except (TypeError, ValueError, OSError):
            pass
    if report_failure:
        print("Authentication failure")
    return False

def main():
    try:
        user = json.loads(os.environ['VCI_RPC_METADATA'])['User']
        if not isinstance(user, str) or not user:
            raise ValueError
    except (KeyError, TypeError, ValueError):
        print("Invalid RPC user metadata", file=sys.stderr)
        sys.exit(1)

    try:
        rpc_input = json.load(sys.stdin)
        if not isinstance(rpc_input, dict):
            raise ValueError
    except ValueError:
        print("Invalid RPC input", file=sys.stderr)
        sys.exit(1)
    current_pw = rpc_input.get("current-password")

    try:
        client = configd.Client()
    except Exception:
        print("Could not connect to configuration service", file=sys.stderr)
        sys.exit(1)

    if sys.argv[1] == "verify-password":
        if not is_current_password(client, user, current_pw):
            sys.exit(1)
    elif sys.argv[1] == "change-password":
        if not is_current_password(client, user, current_pw):
            sys.exit(1)
        new_pw = rpc_input.get("new-password")
        try:
            valid = (isinstance(new_pw, str) and bool(new_pw) and
                     not any(c in new_pw for c in "\0\r\n") and
                     len(new_pw.encode("utf-8")) <= 511)
        except UnicodeEncodeError:
            valid = False
        if not valid:
            print("Invalid new password", file=sys.stderr)
            sys.exit(1)
        pw = ChangePassword(client, user, new_pw, current_pw)
        try:
            pw.change_password()
        except (PasswordChangeError, SavedPasswordError) as exc:
            print(str(exc), file=sys.stderr)
            sys.exit(1)
    else:
        print("Invalid command")
        sys.exit(1)
    sys.exit(0)


if __name__ == "__main__":
    main()
